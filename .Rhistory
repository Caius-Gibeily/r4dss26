babynames
babynames::babynames
# 5
babynames |>
filter(year >= 2000) |>
group_by(sex) |>
summarise(across(c(n, prop),
list(total = sum, max = max))) |>
pivot_longer(-sex, names_to = c("variable", "stat"), names_sep = "_") |>
pivot_wider(names_from = stat, values_from = value)
