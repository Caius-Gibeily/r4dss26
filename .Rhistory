resolution <- 1
x <- seq(-50,50,by=resolution)
y <- seq(-50,50,by=resolution)
compute_dnorm <- function(x,y,scale,sigma) {
density <- scale * dmvnorm(cbind(x,y),
sigma = sigma)
return(density)
}
win <- owin(xrange=c(-5,5),
yrange=c(-5,5))
dnorms <- compute_dnorm(x,y,scale,sigma)
dat <- rpoispp(lambda = compute_dnorm,
lmax = max(dnorms),
win = win,
nsim = 1,
scale = scale,
sigma = corr_mat)
plot(dat)
