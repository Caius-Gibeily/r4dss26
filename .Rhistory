ex3 <- tibble(column = rep(c("x", "y", "z"), each = 10),
values = c(4.2, 5.1, 7.1, 2.1, 7.2, 8.1, 2.2, 8.2, 9.1, 10,
7.3, 7.4, 8.3, 9.2, 2.3, 1.2, 8.5, 9.4, 12.4, 1.5,
8.9, 2.7, 1.4, 7.7, 3.4, 8.7, 9.5, 0.8, 2.9, 9.9))
ex3 |>
pivot_wider(names_from = column, values_from = values)
ex3 <- tibble(column = rep(c("x", "y", "z"), each = 10),
values = as.character(c(4.2, 5.1, 7.1, 2.1, 7.2, 8.1, 2.2, 8.2, 9.1, 10,
7.3, 7.4, 8.3, 9.2, 2.3, 1.2, 8.5, 9.4, 12.4, 1.5,
8.9, 2.7, 1.4, 7.7, 3.4, 8.7, 9.5, 0.8, 2.9, 9.9)),
ID = rep(paste0("ID_", 1:10), 3))
ex3
ex3 |>
pivot_wider(names_from = column, values_from = values)
ex3 |>
pivot_wider(names_from = column, values_from = values,
names_transform = (values = as.numeric))
ex3 |>
pivot_wider(names_from = column, values_from = values,
names_transform = list(values = as.numeric))
flights |>
pivot_longer(
cols = c(arr_delay, dep_delay),
names_to = "delay_type",
values_to = "delay",
names_transform = list(delay = as.character)
)
flights |>
pivot_longer(
cols = c(arr_delay, dep_delay),
names_to = "delay_type",
values_to = "delay",
names_transform = list(delay = as.character)
) |> select(delay)
flights |>
pivot_longer(
cols = c(arr_delay, dep_delay),
names_to = "delay_type",
values_to = "delay",
