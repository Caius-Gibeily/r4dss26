library(palmerpenguinsm)
library(palmerpenguins)
mean_by_species <- function(df, var) {
df |>
group_by(species) |>
summarize(paste0(var,"_avg") := mean({{ var }}, na.rm = TRUE))
}
mean_by_species(penguins,flipper_length_mm)
mean_by_species <- function(df, var) {
df |>
group_by(species) |>
summarize(!!paste0(var,"_avg") := mean({{ var }}, na.rm = TRUE))
}
mean_by_species(penguins,flipper_length_mm)
mean_by_species <- function(df, var) {
df |>
group_by(species) |>
summarize(!!paste0({{var}},"_avg") := mean({{ var }}, na.rm = TRUE))
}
mean_by_species(penguins,flipper_length_mm)
mean_by_species <- function(df, var) {
df |>
group_by(species) |>
summarize(!!paste0(var,"_avg") := mean({{ var }}, na.rm = TRUE))
}
mean_by_species(penguins,flipper_length_mm)
mean_by_species <- function(df, var) {
df |>
group_by(species) |>
summarize(!!paste0(as.character(var),"_avg") := mean({{ var }}, na.rm = TRUE))
}
mean_by_species(penguins,flipper_length_mm)
mean_by_species(penguins,bill_depth_mm)
