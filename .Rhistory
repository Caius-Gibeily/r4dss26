mutate(
# combine & convert delays to hrs and rowund to 1 decimal place
across(c(dep_delay, arr_delay), \(x) round(x / 60, 1), .names = "{.col}_hr"),
# combine & convert origin, carrier & dest into factors
across(c(origin, carrier, dest), as.factor)
)
