) |> select(delay)
df <- tibble(
id = c(1, 2),
jan_2023 = c(10, 20),
feb_2023 = c(15, 25)
)
# Pivot longer and transform the year column to numeric
df_long <- df %>%
pivot_longer(
cols = c(jan_2023, feb_2023),
names_to = c("month", "year"),
names_sep = "_",
names_transform = list(year = as.numeric)
)
df_long
# Pivot longer and transform the year column to numeric
df_long <- df %>%
pivot_longer(
cols = c(jan_2023, feb_2023),
names_to = c("month", "year"),
names_sep = "_"
)
df_long
