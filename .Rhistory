library(nycflights13)
flights |>
pivot_longer(
cols = c(arr_delay, dep_delay),
names_to = "delay_type",
values_to = "delay"
) |>
ggplot(aes(x = carrier, y = delay)) +
geom_boxplot(outlier.shape = NA) +
facet_wrap(~delay_type) +
labs(x = "carrier", y = "delay")
