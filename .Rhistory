usethis::use_git()
library(ggplot2)
p1 <- ggplot(mpg, aes(displ, hwy, color = class)) +
geom_point(size = 3) +
scale_color_brewer(palette = "Set2") +
theme_minimal()
p2 <- ggplot(mpg, aes(displ, hwy, color = cty)) +
geom_point(size = 3) +
scale_color_viridis_c(option = "plasma") +
theme_dark()
p3 <- ggplot(mpg, aes(class, hwy, fill = class)) +
geom_boxplot() +
scale_fill_manual(values = c("2seater" = "#E41A1C", "compact" = "#377EB8",
"midsize" = "#4DAF4A", "minivan" = "#984EA3",
"pickup" = "#FF7F00", "subcompact" = "#FFFF33",
"suv" = "#A65628")) +
theme_bw() +
theme(legend.position = "none",
axis.text.x = element_text(angle = 45, hjust = 1))
p4 <- ggplot(diamonds, aes(carat, price)) +
geom_point(alpha = 0.1) +
scale_x_continuous(breaks = seq(0, 5, 0.5), limits = c(0, 5)) +
scale_y_log10(labels = scales::dollar_format()) +
theme_classic()
p5 <- ggplot(economics, aes(date, unemploy)) +
geom_line(color = "steelblue") +
scale_x_date(date_breaks = "10 years", date_labels = "%Y") +
theme_light(base_size = 14)
p6 <- ggplot(mpg, aes(displ, hwy)) +
geom_point() +
facet_wrap(~ drv) +
scale_x_continuous(name = "Engine Displacement (L)") +
scale_y_continuous(name = "Highway MPG") +
theme_linedraw() +
theme(strip.background = element_rect(fill = "black"),
strip.text = element_text(color = "white", face = "bold"))
p7 <- ggplot(mpg, aes(class, fill = drv)) +
geom_bar(position = "fill") +
scale_y_continuous(labels = scales::percent) +
scale_fill_grey(start = 0.2, end = 0.8) +
theme_void()
p8 <- ggplot(mpg, aes(displ, hwy, size = cyl)) +
geom_point(alpha = 0.6, color = "darkorange") +
scale_size_continuous(range = c(1, 10), breaks = c(4, 6, 8)) +
theme_minimal() +
theme(panel.grid.minor = element_blank(),
panel.background = element_rect(fill = "grey95"),
plot.title = element_text(face = "bold", size = 16))
p9 <- ggplot(mpg, aes(cty, hwy, color = factor(cyl))) +
geom_jitter(width = 0.3, height = 0.3) +
scale_color_manual(values = c("4" = "navy", "5" = "seagreen",
"6" = "goldenrod", "8" = "firebrick"),
name = "Cylinders") +
theme(
panel.background = element_blank(),
axis.line = element_line(color = "black"),
legend.position = "bottom",
legend.title = element_text(face = "italic")
)
p10 <- ggplot(faithfuld, aes(waiting, eruptions, fill = density)) +
geom_raster() +
scale_fill_distiller(palette = "Spectral") +
coord_fixed() +
theme(
axis.title = element_text(size = 12, color = "grey20"),
legend.key.width = unit(1.5, "cm")
)
